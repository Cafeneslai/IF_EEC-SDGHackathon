generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int               @id @default(autoincrement())
  name            String
  age             Int?
  budget_level    String            // ประหยัด, ปานกลาง, หรู
  travel_style    String            // เก็บเป็น JSON string เช่น '["nature", "cafe"]'
  points          Int               @default(0)
  trips           Trip[]
  userCheckpoints UserCheckpoint[]
}

model Location {
  id               Int          @id @default(autoincrement())
  name             String
  type             String       // เที่ยว, กิน, พัก
  lat              Float
  lng              Float
  province         String       // ชลบุรี, ระยอง, ฉะเชิงเทรา
  popularity_score Float        @default(0.0)
  category_tags    String       // เก็บเป็น JSON string
  checkpoints      Checkpoint[]
}

model Trip {
  id         Int      @id @default(autoincrement())
  userId     Int
  startDate  DateTime
  endDate    DateTime
  itinerary  String   // JSON string ของแผนการเดินทาง
  user       User     @relation(fields: [userId], references: [id])
}

model Checkpoint {
  id              Int               @id @default(autoincrement())
  locationId      Int
  reward_points   Int
  coupon_details  String?
  location        Location          @relation(fields: [locationId], references: [id])
  userCheckpoints UserCheckpoint[]
}

model UserCheckpoint {
  id           Int        @id @default(autoincrement())
  userId       Int
  checkpointId Int
  timestamp    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id])
}
